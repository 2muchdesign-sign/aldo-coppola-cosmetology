---
import { u } from '../lib/data.js';
const { items = [] } = Astro.props; // [[name, path]] — последний без ссылки
---
<nav class="acc-crumbs" aria-label="Хлебные крошки">
  <ol>
    <li><a href={u('')}>Косметология</a></li>
    {items.map(([n, p], i) => <li>{i < items.length - 1 ? <a href={u(p)}>{n}</a> : <span aria-current="page">{n}</span>}</li>)}
  </ol>
</nav>
