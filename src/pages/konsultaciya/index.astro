---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHead from '../../components/SectionHead.astro';
import { COSMO_SALONS, u } from '../../lib/data.js';
---
<Base title="Консультация врача-косметолога в Москве | Aldo Coppola" description="Консультация врача-косметолога в салонах Aldo Coppola: осмотр, план процедур, запись онлайн в удобный салон." current="" breadcrumbs={[['Консультация', 'konsultaciya/']]}>
  <div class="acc-wrap">
    <header class="acc-phead">
      <Breadcrumbs items={[['Консультация']]} />
      <h1 class="acc-h1">Решение — <span class="acc-it acc-it--red">вместе с врачом</span></h1>
      <p class="acc-lead">Врач-косметолог осмотрит кожу, ответит на вопросы и составит план процедур. Для инъекций, нитей, HIFU и лазерных процедур консультация — первый шаг.</p>
      <div class="acc-phero__cta"><button type="button" class="acc-btn acc-btn--primary acc-btn--lg" data-book data-consult="1" data-name="Консультация косметолога">Записаться на консультацию</button><button type="button" class="acc-btn acc-btn--secondary acc-btn--lg" data-acc-wa>Написать в WhatsApp</button></div>
    </header>
    <section class="acc-sec acc-sec--tight">
      <SectionHead num="01" label="Как проходит">Что будет на <span class="acc-it">консультации</span></SectionHead>
      <ol class="acc-steps">
        <li><h3 class="acc-h4">Разговор</h3><p class="acc-muted">Ваша задача и ожидания, опыт процедур.</p></li>
        <li><h3 class="acc-h4">Осмотр</h3><p class="acc-muted">Врач оценивает кожу, показания и противопоказания.</p></li>
        <li><h3 class="acc-h4">План</h3><p class="acc-muted">Процедуры, курс, сроки и стоимость.</p></li>
        <li><h3 class="acc-h4">Запись</h3><p class="acc-muted">В удобный салон и время.</p></li>
      </ol>
      <p class="acc-note">Стоимость консультации — [уточняется: в прайсах YClients отдельной позиции «консультация косметолога» нет].</p>
    </section>
    <section class="acc-sec acc-sec--tight">
      <SectionHead num="02" label="Салоны">Где принимают <span class="acc-it">врачи</span></SectionHead>
      <div class="acc-rows">{COSMO_SALONS.map(s => <a class="acc-row" href={u(`salony/${s.slug}/`)}><span><span class="acc-row__n">{s.name}</span><br /><span class="acc-mono">{s.address}</span></span><span class="acc-mono">{s.phone}</span><span class="acc-row__p">→</span></a>)}</div>
    </section>
  </div>
</Base>
