---
import Base from '../../layouts/Base.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import SectionHead from '../../components/SectionHead.astro';
import ZoneMap from '../../components/ZoneMap.astro';
import { PROCEDURES, ZONES, rub, u } from '../../lib/data.js';
const used = ZONES.filter(z => PROCEDURES.some(p => p.zones.includes(z.slug)));
const g = b => used.filter(z => z.body === b);
---
<Base title="Зоны лица и тела — косметология Aldo Coppola" description="Процедуры косметологии по зонам лица и тела: интерактивная схема, цены и салоны Aldo Coppola." current="procedury" breadcrumbs={[['Зоны', 'zony/']]}>
  <div class="acc-wrap">
    <header class="acc-phead"><Breadcrumbs items={[['Зоны']]} /><h1 class="acc-h1">Выберите <span class="acc-it acc-it--red">зону</span></h1>
      <p class="acc-lead">Наведите на точку схемы — справа появятся процедуры для этой зоны. Нажмите, чтобы открыть все процедуры зоны.</p></header>
    <section class="acc-sec acc-sec--tight"><ZoneMap /></section>
    {[['face', 'Лицо'], ['body', 'Тело']].map(([b, t], i) => (
      <section class="acc-sec acc-sec--tight">
        <SectionHead num={`0${i + 1}`} label={t}>{t}: все <span class="acc-it">зоны</span></SectionHead>
        <div class="acc-rows">{g(b).map(z => { const l = PROCEDURES.filter(p => p.zones.includes(z.slug)); return (
          <a class="acc-row" href={u(`zony/${z.slug}/`)}><span class="acc-row__n">{z.name}</span><span class="acc-mono">{l.length} процедур</span><span class="acc-row__p">от {rub(Math.min(...l.map(p => p.price_from)))}</span></a>
        ); })}</div>
      </section>
    ))}
  </div>
</Base>
